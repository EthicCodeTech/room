{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Room",
  "version": "1.2.0",
  "identifier": "in.ethiccode.room",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Room",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "EthicCode",
    "shortDescription": "Make space on your PC, and know what it will do first.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
