# Copy to .env (which is gitignored) and fill in. Nothing secret belongs here: passwords live in your Keychain.
# Name of your certificate, as shown by:  security find-identity -v -p codesigning
DEVELOPER_ID="Developer ID Application: Your Name (TEAMID1234)"
# The profile name you gave to:  xcrun notarytool store-credentials "room-notary"
NOTARY_PROFILE="room-notary"
